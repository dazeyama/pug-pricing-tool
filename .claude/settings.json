{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/workmode.sh\"; exit 0",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/workmode.sh\"; exit 0",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || export PATH=\"/c/Program Files/nodejs:$PATH\"; node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edit.mjs\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Linting the edited file"
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || export PATH=\"/c/Program Files/nodejs:$PATH\"; node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-edit.mjs\"",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Running the tests the edit can affect"
          }
        ]
      }
    ]
  }
}
